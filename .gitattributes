# 统一换行符：源码一律 LF，避免 Windows 提交后 macOS/Linux 构建失败
# （shell 脚本带 CRLF 会在 macOS 上报 bad interpreter: /bin/bash^M）
* text=auto eol=lf

*.sh    text eol=lf
*.swift text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.plist text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.ps1   text eol=crlf
*.bat   text eol=crlf

# 二进制：不要做任何换行转换
*.png  binary
*.gz   binary
*.wasm binary
*.apk  binary
*.jar  binary
*.keystore binary
